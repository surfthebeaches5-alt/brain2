<div id="toast"></div>

<script>
(function(){
  var STORE = "blussomly_stoic_m1_v1";
  var savedMsg = document.getElementById("savedMsg");
  var toast = document.getElementById("toast");
  var saveTimer=null, msgTimer=null;

  function fields(){ return Array.prototype.slice.call(document.querySelectorAll("[data-field]")); }
  function cells(){ return Array.prototype.slice.call(document.querySelectorAll("[data-bingo]")); }

  function collect(){
    var data={text:{},bingo:{}};
    fields().forEach(function(el){ data.text[el.dataset.field]=el.value; });
    cells().forEach(function(el){ data.bingo[el.dataset.bingo]=el.classList.contains("circled"); });
    return data;
  }

  function apply(data){
    if(!data) return;
    if(data.text) fields().forEach(function(el){ if(data.text[el.dataset.field]!=null){el.value=data.text[el.dataset.field]; autosize(el);} });
    if(data.bingo) cells().forEach(function(el){ el.classList.toggle("circled", !!data.bingo[el.dataset.bingo]); });
  }

  function save(){
    try{ localStorage.setItem(STORE, JSON.stringify(collect())); }catch(e){}
    if(savedMsg){ savedMsg.classList.add("show"); clearTimeout(msgTimer); msgTimer=setTimeout(function(){savedMsg.classList.remove("show");},1400); }
  }
  function queueSave(){ clearTimeout(saveTimer); saveTimer=setTimeout(save,400); }

  function load(){
    try{ var raw=localStorage.getItem(STORE); if(raw) apply(JSON.parse(raw)); }catch(e){}
  }

  function autosize(el){
    if(el.tagName!=="TEXTAREA") return;
    el.style.height="auto";
    el.style.height=Math.max(el.scrollHeight, parseInt(getComputedStyle(el).minHeight)||28)+"px";
  }

  function showToast(t){ toast.textContent=t; toast.classList.add("show"); setTimeout(function(){toast.classList.remove("show");},1800); }

  // wire fields
  fields().forEach(function(el){
    autosize(el);
    el.addEventListener("input",function(){ autosize(el); queueSave(); });
  });
  // wire bingo
  cells().forEach(function(el){
    el.addEventListener("click",function(){ el.classList.toggle("circled"); save(); });
  });

  // jump nav
  document.getElementById("jump").addEventListener("change",function(e){
    var id=e.target.value; if(!id) return;
    var t=document.getElementById(id); if(t) t.scrollIntoView({behavior:"smooth",block:"start"});
    e.target.selectedIndex=0;
  });

  // export
  document.getElementById("btnExport").addEventListener("click",function(){
    var blob=new Blob([JSON.stringify(collect(),null,2)],{type:"application/json"});
    var a=document.createElement("a");
    var d=new Date().toISOString().slice(0,10);
    a.href=URL.createObjectURL(blob); a.download="stoic-starter-module1-"+d+".json";
    document.body.appendChild(a); a.click(); a.remove();
    showToast("Answers exported ✓");
  });

  // print
  document.getElementById("btnPrint").addEventListener("click",function(){ window.print(); });

  // reset
  document.getElementById("btnReset").addEventListener("click",function(){
    if(!confirm("Clear all your answers on every page? This can't be undone (export first if you want a copy).")) return;
    fields().forEach(function(el){ el.value=""; autosize(el); });
    cells().forEach(function(el){ el.classList.remove("circled"); });
    save(); showToast("Cleared");
  });

  load();
})();
</script>
